# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging / build artifacts
build/
dist/
wheels/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# Phishbowl local runtime artifacts (on-disk enrichment cache, generated reports)
.phishbowl_cache/
*.report.html

# Secrets & local config — never commit real keys. Keep the template.
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
