# Phishbowl — example environment file.
#
# Copy this to `.env` and fill in API keys for the OSINT enrichment connectors
# you want to use:  cp .env.example .env
#
# Phishbowl is OFFLINE-FIRST. Every key below is OPTIONAL — with none set, the
# full offline pipeline still produces a complete verdict and report. Keys only
# unlock the enrichment layer (PRD §9).
#
# Keys are SECRETS: Phishbowl never logs them and never writes them into any
# report or JSON output. Your real `.env` is gitignored — never commit it.

# VirusTotal (https://www.virustotal.com) — URL / domain / file-hash reputation.
VIRUSTOTAL_API_KEY=

# urlscan.io (https://urlscan.io) — URL scanning. Submissions default to PRIVATE.
URLSCAN_API_KEY=

# AbuseIPDB (https://www.abuseipdb.com) — abuse confidence for the sending IP.
ABUSEIPDB_API_KEY=

# Shodan (https://www.shodan.io) — exposed-service context for related IPs.
SHODAN_API_KEY=

# Note: the WHOIS/RDAP connector (domain age) needs no API key.
