# PhishBowl — example environment file.
#
# PhishBowl reads these variables from the process environment; it does not load
# a .env file itself. Export them in your shell, or load this file with a tool
# such as `set -a; . ./.env; set +a`. Your real `.env` is gitignored: never
# commit it.
#
# PhishBowl is OFFLINE-FIRST. Every key below is OPTIONAL. With none set, the
# offline pipeline still produces a complete report; keys only unlock the
# optional enrichment connectors (`phishbowl analyze --enrich`).
#
# Keys are SECRETS: PhishBowl never logs them and never writes them into any
# report, JSON output, or cache entry.

# VirusTotal (https://www.virustotal.com) — URL, domain, and file-hash reputation.
VIRUSTOTAL_API_KEY=

# urlscan.io (https://urlscan.io) — searches prior scans by domain. With
# --urlscan-submit it submits URLs instead (private scans), which makes urlscan
# visit them.
URLSCAN_API_KEY=

# AbuseIPDB (https://www.abuseipdb.com) — abuse confidence for IP addresses.
ABUSEIPDB_API_KEY=

# Shodan (https://www.shodan.io) — exposed services on IP addresses.
SHODAN_API_KEY=

# The RDAP connector (domain age) needs no key.

# Optional: a YAML scoring override layered over the bundled defaults
# (docs/SCORING.md). Equivalent to `phishbowl analyze --scoring-config PATH`.
# PHISHBOWL_SCORING_CONFIG=/etc/phishbowl/scoring.yaml

# Optional: the enrichment cache directory. Defaults to
# $XDG_CACHE_HOME/phishbowl/enrichment, else ~/.cache/phishbowl/enrichment.
# PHISHBOWL_CACHE_DIR=/var/cache/phishbowl
